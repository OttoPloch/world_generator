setup {
    parent {
        parent = .
        type = base
        data = position: 0, 0, 0, 1
    }
    slot_0_text {
        parent = parent
        type = text
        data = position: 0, 0, 1; text: PLACEHOLDER; character_size: 16; color: 255, 50, 150; style: 1
    }
    slot_1_text {
        parent = parent
        type = text
        data = position: 0, 20, 1; text: PLACEHOLDER; character_size: 16; color: 255, 40, 160; style: 1
    }
    slot_2_text {
        parent = parent
        type = text
        data = position: 0, 40, 1; text: PLACEHOLDER; character_size: 16; color: 255, 40, 160; style: 1
    }
    slot_3_text {
        parent = parent
        type = text
        data = position: 0, 60, 1; text: PLACEHOLDER; character_size: 16; color: 255, 0, 0; style: 1
    }
}

update {
    slot_0_text {
        data = text: {SLOT_0}
    }
    slot_1_text {
        data = text: {SLOT_1}
    }
    slot_2_text {
        data = text: {SLOT_2}
    }
    slot_3_text {
        data = text: {SLOT_3}
    }
}
